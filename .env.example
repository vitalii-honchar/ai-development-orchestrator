# Local browser development uses a dedicated test database.
FACTORY_WEB_SERVER_PORT=8716
FACTORY_STORAGE_MODE=sqlite
FACTORY_SQLITE_PATH=.factory-data/control-plane-test.db
FACTORY_SQLITE_MAX_OPEN_CONNS=4

# Codex steps require a current Codex CLI with saved authentication.
# Set an absolute executable path when several versions are installed.
FACTORY_CODEX_BIN=codex

# Optional, create-only bootstrap account. Set both values or leave both empty.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Required: generate a unique random secret with at least 32 bytes.
WEB_AUTH_SECRET_KEY=
# Enable secure cookies when serving through HTTPS.
PRODUCTION=false
