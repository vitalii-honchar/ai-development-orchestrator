# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
.vscode/

# OS metadata
.DS_Store

# Compiled CLI binaries (from `go build -o <name> ./cmd/<name>`)
/devicemqtt
/mqttconsumer

__debug_bin*

# Git worktrees
/.worktree/
.worktrees/
/.gitworktrees/

# Locally-generated dev certificates (see `make certs`).
/certs/
# Cross-compiled binaries (make build-pi).
/bin/
*.db
*.db-shm
*.db-wal
messages.csv
*.session.sql
/.factory-data/
/factory
/factoryd

# Keep complete vendor trees, including dependency files matching patterns above.
!**/vendor/**

# Local planning documents
/docs/superpowers/

# Local autoresearch artifacts
/autoresearch/
